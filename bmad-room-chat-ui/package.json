{
  "name": "bmad-room-chat-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local backend daemon for BMad Room chat UI (Project persistence, fs-browse, projects REST).",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "nanoid": "5.1.16"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "@types/node": "22.10.5",
    "@types/better-sqlite3": "7.6.11"
  }
}
