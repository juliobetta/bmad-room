{
  "name": "bmad-room-chat-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BMad Room chat UI — Next.js app serving both the UI and /api/* from one process (Project persistence, fs-browse, projects REST).",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "better-sqlite3": "13.0.3",
    "nanoid": "5.1.16",
    "next": "16.3.5",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "smol-toml": "1.8.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty"
    ]
  }
}
